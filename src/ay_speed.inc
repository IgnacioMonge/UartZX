; AY bit-banged UART driver, optional part: switch the ESP to 9600 baud.
; Include after ay.inc, only if the application calls it.
;
;   uart_esp_set_9600  Send CR LF "AT+UART_DEF=9600,8,1,0,2" CR LF at 115200
;                      baud, the rate an ESP has from the factory. Call it
;                      after uart_init, with the ESP already booted. Returns
;                      with interrupts enabled. Destroys A, BC, E, HL.
;
; AT+UART_DEF is the persistent form: the ESP stores it in flash and keeps
; 9600 baud with CTS flow control for everything that uses it afterwards,
; other interfaces included. An ESP already at 9600 receives the burst as
; garbage: wait for its answer and call uart_flush before the first command,
; and expect that command to fail if the garbage is still in its line.
;
; A bit lasts 30 T-states, which is 116,667 baud at 3.5 MHz (1.3 % fast) and
; 118,230 at 3.5469 MHz (2.6 % fast). The loop cannot be a counted one: the
; nine timed bits of each character are written out, and only the stop bit,
; which may be any length, carries the loop. OUTI lowers B, so every bit
; puts it back and all of them use the same port address. INC B leaves Z
; clear, so the two RET Z never return: they are 5 T-states of delay each.

uart_esp_set_9600:
    ld bc, UART_AY_REGISTER
    ld a, UART_AY_PORT_A
    di
    out (c), a
    ld hl, uart_speed_sequence
    ld b, UART_AY_DATA / 256    ; C is the same in both ports
    ld e, 28                    ; characters
uart_esp_set_9600_char:
    outi
    inc b
    ret z
    ret z
    outi
    inc b
    ret z
    ret z
    outi
    inc b
    ret z
    ret z
    outi
    inc b
    ret z
    ret z
    outi
    inc b
    ret z
    ret z
    outi
    inc b
    ret z
    ret z
    outi
    inc b
    ret z
    ret z
    outi
    inc b
    ret z
    ret z
    outi
    inc b
    ret z
    ret z
    outi                        ; the stop bit
    ld bc, UART_AY_DATA
    dec e
    jr nz, uart_esp_set_9600_char
    ei
    ret

; Port values, ten per character: start, eight data bits, stop.
uart_speed_sequence:
    defb 0xf6, 0xfe, 0xf6, 0xfe, 0xfe, 0xf6, 0xf6, 0xf6, 0xf6, 0xfe
    defb 0xf6, 0xf6, 0xfe, 0xf6, 0xfe, 0xf6, 0xf6, 0xf6, 0xf6, 0xfe
